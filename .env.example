DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET="asdkjhkjkkkh987879879879987khkas"
SUBSCRIPTION_SERVICE_PORT=3007
NODE_ENV=development
SERVICE_NAME=subscription-service
LOG_LEVEL=debug

# Razorpay — UAT uses rzp_test_* keys (test dashboard); prod uses rzp_live_* keys (live dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-env-secret
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_DEFAULT_TOTAL_COUNT=12
# On service start, create missing Razorpay plans for this environment's keys
RAZORPAY_SYNC_ON_STARTUP=true
# true only when this env is switching to a different Razorpay account
RAZORPAY_SYNC_FORCE=false
CHECKOUT_DISPLAY_NAME=Sahayi
INTERNAL_SERVICE_TOKEN=replace-with-shared-internal-token
# Local User Service. Use http://20.40.58.216:3005 only when User Service is hosted.
USER_SERVICE_BASE_URL=http://localhost:3005
